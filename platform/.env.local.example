# ─── Supabase (required) ───────────────────────────────────────────────────────
# Found at: supabase.com → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── LLM Provider (required) ───────────────────────────────────────────────────
# Options: anthropic | openai | deepseek | groq
# Only the matching API key below needs to be filled in.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ─── Upstash Redis (optional — rate limiting disabled if omitted) ───────────────
# Found at: console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
